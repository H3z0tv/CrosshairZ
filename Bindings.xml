<Bindings>
	<Binding name="CROSSHAIRZ_TOGGLE" header="CROSSHAIRZ" category="ADDONS">
		CrosshairZ_ToggleKey()
	</Binding>
	<Binding name="CROSSHAIRZ_HOLD" category="ADDONS" runOnUp="true">
		if keystate == "down" or keystate == "up" then
			CrosshairZ_HoldKey(keystate)
		end
	</Binding>
	<Binding name="CROSSHAIRZ_LOCK" category="ADDONS">
		CrosshairZ_TargetLockKey()
	</Binding>
	<Binding name="CROSSHAIRZ_FLIP" category="ADDONS">
		CrosshairZ_FlipKey()
	</Binding>
</Bindings>
